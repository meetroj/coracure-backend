NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
DATABASE_URL=postgresql://coracure:coracure@localhost:5432/coracure
# Optional - nothing in this service reads Redis today. Needed only for a
# multi-node LiveKit cluster (see DEPLOYMENT.md).
# REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_MFA_TTL=5m
CORS_ORIGINS=http://localhost:5173

# External integrations (optional until their modules are configured)
# OTP: 'slide' in production, 'stub' for local work (accepts OTP_STUB_CODE)
OTP_PROVIDER=stub
OTP_STUB_CODE=000000
SLIDE_BASE_URL=https://api.slide.dev
SLIDE_API_KEY=
SLIDE_TIMEOUT_MS=8000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OPENAI_API_KEY=
# Document storage: 's3' in production, 'stub' locally (signs a URL that goes
# nowhere, so the upload and review flow can be driven without a bucket)
STORAGE_PROVIDER=stub
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_URL_TTL_SECONDS=300

# Platform foundation
LOG_LEVEL=info
# true when TLS terminates at a load balancer, so the real client IP is trusted
TRUST_PROXY=false
# OpenAPI at /docs; defaults to on outside production
SWAGGER_ENABLED=true
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=10000
APP_CONFIG_CACHE_TTL_MS=30000

# Host ports docker compose publishes on; override when 5432/6379 are taken
POSTGRES_PORT=5432
REDIS_PORT=6379

# M-07 scheduling. The wall clock every provider diary is written in.
# Weekly patterns and blocked dates are local times; consultations are instants.
PLATFORM_TIMEZONE=Asia/Kolkata

# M-08 push. Leave as `log` until the Firebase service accounts exist: it
# writes what it would have sent and delivers nothing. Production refuses it.
# The patient and doctor apps are separate store listings, so separate projects.
PUSH_PROVIDER=log
# FCM_PATIENT_CREDENTIALS=<service-account JSON, or the same JSON base64-encoded>
# FCM_DOCTOR_CREDENTIALS=<service-account JSON, or the same JSON base64-encoded>
PUSH_TIMEOUT_MS=8000

# M-09 search. The mapping is deterministic and clinically approved; the
# assistant is consulted only when it matched nothing, and only to pick from
# concerns that already exist. `none` is a complete search on its own.
SEARCH_AI_PROVIDER=none
# OPENAI_API_KEY=sk-...
SEARCH_AI_MODEL=gpt-4o-mini
SEARCH_AI_TIMEOUT_MS=4000

# M-12 payments. `stub` settles nothing and signs its own webhooks, so the
# whole billing flow runs before a Razorpay account exists. Production refuses it.
PAYMENT_GATEWAY=stub
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# M-14 video consultation. LiveKit is SELF-HOSTED - `docker compose up livekit`
# runs the real thing locally, so there is no stub provider here: the same code
# path runs against the local container and against AWS, and only these values
# change (LiveKit_strategy 25, 32).
#
# The key/secret pair below is the one committed to livekit/livekit.yaml. It is
# public by design and refused in production, which generates its own pair.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
# Minutes, not hours: a join token cannot be revoked, only expired.
LIVEKIT_TOKEN_TTL_SECONDS=300

# Host ports docker compose publishes LiveKit on; the UDP media range is fixed
# at 50000-50019 in compose because each port is forwarded individually.
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
